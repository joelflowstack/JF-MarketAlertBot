# ---- Telegram ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=          # random string, verifies Telegram webhook requests

# ---- Discord ----
DISCORD_BOT_TOKEN=                # Developer Portal -> Bot -> Reset Token
DISCORD_PUBLIC_KEY=               # Developer Portal -> General Information -> Public Key
DISCORD_APPLICATION_ID=           # Developer Portal -> General Information -> Application ID

# ---- Firebase (Admin SDK - server side) ----
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=             # keep the \n escapes, wrap in quotes

# ---- Firebase (Web SDK - client dashboard) ----
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=

# ---- Market Data ----
TWELVE_DATA_API_KEY=

# ---- Alert Engine ----
CRON_SECRET=                      # shared secret so only our scheduler can trigger /api/cron/check-alerts

# ---- Admin ----
ADMIN_CHAT_IDS=                   # comma-separated Telegram Chat IDs allowed to view /admin stats
